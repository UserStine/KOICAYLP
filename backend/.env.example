PORT=4000
NODE_ENV=development

# Comma-separated frontend origins. Production must use HTTPS.
FRONTEND_URL=http://localhost:5173

# REQUIRED in production. Generate at least 32 random bytes.
YLP_SECRET=
SESSION_TTL_MINUTES=480
REQUIRE_EMAIL_VERIFICATION=false
AUTH_TOKEN_TTL_MINUTES=15

# Abuse protection
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT=8
SIGNUP_RATE_LIMIT_PER_HOUR=5
AI_RATE_LIMIT_PER_MINUTE=10

# Server-side AI only. Never prefix this with VITE_ and never expose it to React.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Server-side transactional mail webhook used for verification/reset links.
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=

# Programme calendar year used to parse the current module day headings.
PROGRAM_YEAR=2026
