PORT=4000
NODE_ENV=development

# Frontend origins, comma-separated.
FRONTEND_URL=http://localhost:5173

# Required in production.
YLP_SECRET=replace-with-a-long-random-secret
SESSION_TTL_MINUTES=480
AUTH_TOKEN_TTL_MINUTES=15

# Supabase - SERVER ONLY. Never expose the service-role key to React/Vite.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Application URLs remain server-controlled. Supabase controls open/closed status.
PUBLIC_SECTOR_FORM_URL=
PRIVATE_SECTOR_FORM_URL=
PUBLIC_SECTOR_SUBMIT_URL=
PRIVATE_SECTOR_SUBMIT_URL=

# Safe fallback when Supabase is not configured.
APPLICATIONS_OPEN=false
APPLICATION_CLOSE_AT=

# Abuse protection
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT=10
SIGNUP_RATE_LIMIT_PER_HOUR=20
AI_RATE_LIMIT_PER_MINUTE=10

# Server-side AI only.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=
RAG_TOP_K=5
RAG_MIN_SCORE=0.2

EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_TOKEN=
PROGRAM_YEAR=2026
